[
 {
  "name": "plain",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"plain\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "plain"
 },
 {
  "name": "backslash (doubled in the text)",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"a\\\\b\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "a\\b"
 },
 {
  "name": "double quote (escaped)",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"a\\\"b\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "a\"b"
 },
 {
  "name": "backslash and quote together",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"x\\\\\\\"y\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "x\\\"y"
 },
 {
  "name": "a raw line feed inside the quotes is one value",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"a\nb\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "a\nb"
 },
 {
  "name": "two line feeds, the second line looks like a variable",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"a\n.1.3.6.1 = INTEGER: 5\nb\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "a\n.1.3.6.1 = INTEGER: 5\nb"
 },
 {
  "name": "a value that ends with a line feed and a space (the corpus aos6 ifName), white space around is trimmed",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"Uplink x\n2D 31 00 \"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "Uplink x\n2D 31 00"
 },
 {
  "name": "NUL is a Hex-STRING",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = Hex-STRING: 61 00 62 \n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "61:00:62"
 },
 {
  "name": "a non-printable byte is a Hex-STRING",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = Hex-STRING: 61 01 62 \n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "61:01:62"
 },
 {
  "name": "UTF-8 is a STRING",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"ä€\"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "ä€"
 },
 {
  "name": "leading and trailing white space inside the quotes is trimmed",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"  a b  \"\n.1.3.6.1.2.1.31.1.1.1.15.1 = Gauge32: 1000\n",
  "expect_ifname": "a b"
 }
