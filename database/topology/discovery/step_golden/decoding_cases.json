 {
  "name": "ports: ifName and ifDescr apart, no fallback of ifName to ifDescr",
  "source": "ports",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.2.2.1.2.1 = STRING: \"eth0\"\n",
  "expect": {
   "{#IFNAME}": null,
   "{#IFDESCR}": "eth0"
  }
 },
 {
  "name": "ports: both names",
  "source": "ports",
  "walk": ".1.3.6.1.2.1.2.2.1.1.1 = INTEGER: 1\n.1.3.6.1.2.1.2.2.1.3.1 = INTEGER: ethernetCsmacd(6)\n.1.3.6.1.2.1.31.1.1.1.1.1 = STRING: \"Gi0/1\"\n.1.3.6.1.2.1.2.2.1.2.1 = STRING: \"GigabitEthernet0/1\"\n",
  "expect": {
   "{#IFNAME}": "Gi0/1",
   "{#IFDESCR}": "GigabitEthernet0/1"
  }
 },
 {
